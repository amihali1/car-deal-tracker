# Copy to .env (gitignored). Never commit the real values.

# Gmail address that receives the saved-search alert emails. Use a separate inbox just for car alerts.
IMAP_USER=
# Gmail app password for that address (Google Account > Security > 2-Step Verification > App passwords).
IMAP_PASSWORD=
# ntfy.sh topic for push alerts. Pick an unguessable name; anyone who knows it can read your alerts.
NTFY_TOPIC=

# --- Only needed for scripts/deploy.sh -------------------------------------------------------
# SSH target of the server that runs the cron scan + dashboard, e.g. me@192.168.1.20
DEPLOY_HOST=
# Cron schedule for scans, in the server's clock (default: every 3h, 07:00-22:00).
SCAN_CRON=
# Optional: require this token for the web dashboard (open http://<host>:8095/?token=... once per device).
WEB_TOKEN=
# Optional: Tailscale auth key to reach the dashboard from your phone anywhere (one-off, not ephemeral).
TS_AUTHKEY=
